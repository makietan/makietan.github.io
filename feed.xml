<span class="kd">const</span> <span class="p">{</span> <span class="nx">stderr</span> <span class="p">}</span> <span class="o">=</span> <span class="nf">require</span><span class="p">(</span><span class="dl">'</span><span class="s1">node:process</span><span class="dl">'</span><span class="p">);</span>

<span class="kd">const</span> <span class="nx">successMessage</span> <span class="o">=</span> <span class="nf">styleText</span><span class="p">(</span><span class="dl">'</span><span class="s1">green</span><span class="dl">'</span><span class="p">,</span> <span class="dl">'</span><span class="s1">Success!</span><span class="dl">'</span><span class="p">);</span>
<span class="nx">console</span><span class="p">.</span><span class="nf">log</span><span class="p">(</span><span class="nx">successMessage</span><span class="p">);</span>

<span class="kd">const</span> <span class="nx">errorMessage</span> <span class="o">=</span> <span class="nf">styleText</span><span class="p">(</span>
  <span class="dl">'</span><span class="s1">red</span><span class="dl">'</span><span class="p">,</span>
  <span class="dl">'</span><span class="s1">Error! Error!</span><span class="dl">'</span><span class="p">,</span>
  <span class="c1">// Validate if process.stderr has TTY</span>
  <span class="p">{</span> <span class="na">stream</span><span class="p">:</span> <span class="nx">stderr</span> <span class="p">},</span>
<span class="p">);</span>
<span class="nx">console</span><span class="p">.</span><span class="nf">error</span><span class="p">(</span><span class="nx">errorMessage</span><span class="p">);</span>
</code></pre></div></div>

<p>ちなみに picocolors は以下のように使っていた。</p>

<div class="language-javascript highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="kd">const</span> <span class="nx">pico</span> <span class="o">=</span> <span class="nf">require</span><span class="p">(</span><span class="dl">'</span><span class="s1">picocolors</span><span class="dl">'</span><span class="p">);</span>

<span class="kd">const</span> <span class="nx">successMessage</span> <span class="o">=</span> <span class="nx">pico</span><span class="p">.</span><span class="nf">green</span><span class="p">(</span><span class="dl">'</span><span class="s1">Success!</span><span class="dl">'</span><span class="p">);</span>
<span class="nx">console</span><span class="p">.</span><span class="nf">log</span><span class="p">(</span><span class="nx">successMessage</span><span class="p">);</span>

<span class="kd">const</span> <span class="nx">errorMessage</span> <span class="o">=</span> <span class="nx">pico</span><span class="p">.</span><span class="nf">red</span><span class="p">(</span><span class="dl">'</span><span class="s1">Error! Error!</span><span class="dl">'</span><span class="p">);</span>
<span class="nx">console</span><span class="p">.</span><span class="nf">error</span><span class="p">(</span><span class="nx">errorMessage</span><span class="p">);</span>
</code></pre></div></div>

<p>こっちのほうがすっきりしとるやないかーい。</p>]]></content><author><name>makietan</name></author><category term="tech" /><summary type="html"><![CDATA[nodejs.org Util | Node.js v26.8.1 Documentation]]></summary></entry><entry><title type="html">ふるさと納税で貰ったローソファーがボロボロなので粗大ごみとして出す</title><link href="https://makietan.github.io/life/2026/09/12/report.html" rel="alternate" type="text/html" title="ふるさと納税で貰ったローソファーがボロボロなので粗大ごみとして出す" /><published>2026-09-12T00:00:00+09:00</published><updated>2026-09-12T00:00:00+09:00</updated><id>https://makietan.github.io/life/2026/09/12/report</id><content type="html" xml:base="https://makietan.github.io/life/2026/09/12/report.html"><![CDATA[<p>2017年に行ったふるさとチョイスでのふるさと納税のもの。</p>

