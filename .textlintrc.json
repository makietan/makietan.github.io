{
  "plugins": {},
  "filters": {},
  "rules": {
    "preset-japanese": true,
    "preset-ja-technical-writing": {
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "",
        "preferInList": "",
        "strict": false
      },
      "max-kanji-continuous-len": {
        "allow": [
          "見沼代親水公園行",
          "西新井大師西駅",
          "京急久里浜行",
          "裏側守備表示",
          "三井住友銀行",
          "熱力学第二法則",
          "標準正規分布",
          "中心極限定理",
          "情報通信機器",
          "外部記憶媒体",
          "連続作業時間",
          "近鉄南大阪線",
          "近鉄名古屋駅",
          "大阪阿部野橋",
          "外国人観光客",
          "巴哈姆特動畫瘋",
          "香港政府衛生署",
          "文化的寛容性"
        ]
      },
      "ja-unnatural-alphabet": {
        "allow":[
          "t値",
          "z分布"
        ]
      }
    },
    "@textlint-ja/preset-ai-writing": {
      "ai-tech-writing-guideline": {
        "severity": "info"
      }
    }
  }
}