{
  "plugins": {},
  "filters": {},
  "rules": {
    "preset-japanese": true,
    "preset-ja-technical-writing": {
      "max-kanji-continuous-len": {
        "allow": [
          "見沼代親水公園行",
          "西新井大師西駅",
          "京急久里浜行",
          "裏側守備表示",
          "三井住友銀行",
          "熱力学第二法則",
          "標準正規分布",
          "中心極限定理"
        ]
      },
      "ja-unnatural-alphabet": {
        "allow":[
          "t値",
          "z分布"
        ]
      }
    },
    "@textlint-ja/preset-ai-writing": {
      "ai-tech-writing-guideline": {
        "severity": "info"
      }
    }
  }
}